# Backend
BACKEND_PORT=8000

# AI providers are optional. Leave unset for deterministic local fallback.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_NOVA_VOICE_ID=
ELEVENLABS_AXEL_VOICE_ID=
ELEVENLABS_SAGE_VOICE_ID=
ELEVENLABS_VEX_VOICE_ID=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Jobs providers are optional. Placeholder values only — never commit real keys.
# Leave unset and the feed serves Remotive/RemoteOK/Jobicy/Arbeitnow; keyed
# providers that are unreachable or in an unsupported country are reported as
# skipped/failed and never break the live feed.
# RapidAPI shares one account key across all job APIs; per-provider overrides
# take priority when set, otherwise RAPIDAPI_KEY is used.
JSEARCH_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_LINKEDIN_KEY=
RAPIDAPI_GOOGLE_JOBS_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
USAJOBS_API_KEY=
# Exact RapidAPI host + endpoint path of the SUBSCRIBED LinkedIn / Google Jobs
# apps (from the RapidAPI Endpoints tab). Do NOT guess: leave blank to disable
# the provider (it reports "host_not_configured" instead of attempting a wrong
# host).
LINKEDIN_JOBS_HOST=
LINKEDIN_JOBS_PATH=
GOOGLE_JOBS_HOST=
GOOGLE_JOBS_PATH=

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# Database (PostgreSQL)
POSTGRES_DB=skillbridge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production