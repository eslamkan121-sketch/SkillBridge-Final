{
  "name": "skillbridge-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fix-bin": "node -e \"const{spawnSync}=require('child_process');if(process.platform==='linux'&&/microsoft/i.test(require('fs').readFileSync('/proc/version','utf8'))){spawnSync('chmod',['+x',require('fs').readdirSync('node_modules/.bin').map(f=>'node_modules/.bin/'+f)],{stdio:'inherit'});}\"",
    "prebuild": "npm run fix-bin",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow-models/face-landmarks-detection": "^1.0.6",
    "@tensorflow/tfjs": "^4.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
