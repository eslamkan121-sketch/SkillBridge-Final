# Backend
BACKEND_PORT=8000

# AI providers are optional. Leave unset for deterministic local fallback.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_NOVA_VOICE_ID=
ELEVENLABS_AXEL_VOICE_ID=
ELEVENLABS_SAGE_VOICE_ID=
ELEVENLABS_VEX_VOICE_ID=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Jobs providers are optional. Placeholder values only — never commit real keys.
# Leave unset and the feed serves Remotive/RemoteOK/Jobicy/Arbeitnow; keyed
# providers that are unreachable or in an unsupported country are reported as
# skipped/failed and never break the live feed.
JSEARCH_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
USAJOBS_API_KEY=

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# Database (PostgreSQL)
POSTGRES_DB=skillbridge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production